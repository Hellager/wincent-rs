# wincent add_item latency test - local configuration
#
# Copy this file to `.env` in the same directory and fill in the values for
# your dedicated Windows test VM. `.env` is git-ignored because it contains the
# guest password.
#
# The host orchestrator resolves values in this order:
#   command-line parameter > .env value > built-in default (non-secret only)
#
# When a value contains spaces, do not quote it; everything after `=` is used
# verbatim after trimming. Full-line comments start with `#`.

# Path to vmrun.exe on the host.
WINCENT_VM_VMRUN=C:\VMware\vmrun.exe

# Full path to the target .vmx file.
WINCENT_VM_VMX=C:\VirtualMachine\Windows10\Windows 10 x64.vmx

# Guest account used by vmrun guest control. Use the local account name or
# DOMAIN\user. The launcher adds the guest computer name when no domain is given.
WINCENT_VM_GUEST_USER=wincent

# Guest password. Keep this file out of version control.
WINCENT_VM_GUEST_PASSWORD=change-me

# Root directory for host-side evidence. Relative paths resolve from the repo
# root. A timestamped directory is created under it.
WINCENT_EVIDENCE_ROOT=evidence

# Benchmark defaults. Command-line parameters -Series/-Iters/-Warmup override
# these values.
WINCENT_ADD_LATENCY_SERIES=recent,frequent
WINCENT_ADD_LATENCY_ITERS=20
WINCENT_ADD_LATENCY_WARMUP=2
