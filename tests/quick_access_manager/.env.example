# Copy to .env (git-ignored). Never commit actual VM credentials.
WINCENT_VM_VMRUN=C:\VMware\vmrun.exe
WINCENT_VM_VMX=C:\VirtualMachine\Windows10\Windows 10 x64.vmx
WINCENT_VM_GUEST_USER=test-user
WINCENT_VM_GUEST_PASSWORD=replace-me
WINCENT_VM_PLATFORM=win10
# Optional password for an encrypted VMware guest.
WINCENT_VM_PASSWORD=
