# wincent status query validation - local configuration
#
# Copy this file to `.env` in the same directory and fill in the values for
# your dedicated Windows test VM. `.env` is git-ignored because it contains the
# guest password.

# Path to vmrun.exe on the host.
WINCENT_VM_VMRUN=C:\VMware\vmrun.exe

# Full path to the target .vmx file.
WINCENT_VM_VMX=C:\VirtualMachine\Windows10\Windows 10 x64.vmx

# Guest account used by vmrun guest control.
WINCENT_VM_GUEST_USER=wincent

# Guest password. Keep this file out of version control.
WINCENT_VM_GUEST_PASSWORD=change-me

# Root directory for host-side evidence. Relative paths resolve from the repo
# root. A timestamped directory is created under it.
WINCENT_EVIDENCE_ROOT=evidence

# Set to 0 to skip the add/remove round trip and only validate read-only state.
WINCENT_STATUS_QUERY_MUTATE=1
